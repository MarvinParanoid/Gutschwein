# --- Telegram ---
# From @BotFather
BOT_TOKEN=123456:AA...
# Who may open the app. Send /id to the bot to find your own.
ALLOWED_TELEGRAM_IDS=111111111,222222222
# Public https URL of the Mini App (the domain of your reverse proxy).
WEBAPP_URL=https://sparschwein.example.com
# Chat that receives notifications (new voucher, used, comments, expiry).
# Family group id (negative number) or your own id. Leave empty to disable.
FAMILY_CHAT_ID=

# --- App ---
RUN_BOT=true
# In Docker these come from the image; set them only when running locally.
# DATA_DIR=./data
# DATABASE_URL=sqlite+aiosqlite:///./data/sparschwein.db

# Allows the X-Dev-User header instead of Telegram auth. NEVER enable in production.
DEV_MODE=false
# Needed only when the Vite dev server runs on another origin.
CORS_ORIGINS=
